# ===== Feishu (Lark) custom bot - primary alert channel =====
# Create a bot in your Feishu group: Settings -> Group Robots -> Add Robot -> Custom
# Copy the webhook URL and (recommended) the signing secret.
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_SECRET=

# ===== Email fallback (optional) =====
# Only used when FEISHU_WEBHOOK is NOT set.
EMAIL_ADDRESS=yourname@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
ALERT_EMAIL=recipient@example.com
